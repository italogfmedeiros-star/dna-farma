# Copie para .env.local (nunca commitado) para desenvolvimento local.
# Em produção, configure as mesmas 3 variáveis em:
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API. Públicas por design (RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role (secret!).
# Usada só em código server-only (convite de usuários). NUNCA prefixar com
# NEXT_PUBLIC_, nunca commitar, nunca colar em chat/issue/PR.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em e-mails de convite e metadados). Em produção
# na Vercel isto já deveria bater com o domínio real do projeto.
NEXT_PUBLIC_SITE_URL=https://dna-farma.vercel.app
